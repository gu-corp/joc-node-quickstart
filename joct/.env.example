# Execution client (Geth) image tag — v1.11.6 is the version officially tested by JOC
GETH_VERSION=v1.11.6

# Consensus client (Lighthouse) image tag. JOC hasn't pinned a known-good version for
# the PoSA testnet yet — "latest" is a placeholder; pin to a specific tag once known-good.
LIGHTHOUSE_VERSION=latest

# Override official bootnodes if needed (comma-separated enode URLs).
# Leave empty to use the defaults baked into ./el/entrypoint.sh.
BOOTNODES=

# Override official consensus bootnode ENRs if needed (comma-separated).
# Leave empty to use the defaults baked into ./cl/entrypoint.sh.
BOOT_ENRS=

# Host ports (offset from mainnet defaults so both nodes can run side by side)
HTTP_RPC_PORT=18545
P2P_PORT=30304
BEACON_HTTP_PORT=15052
BEACON_P2P_PORT=19000

# Enabled RPC API namespaces
HTTP_APIS=eth,net,web3,txpool

# Optional explorer (docker compose --profile explorer up -d)
EXPLORER_PORT=18080
# RPC URL as seen from the user's browser
EXPLORER_NODE_URL=http://localhost:18545
